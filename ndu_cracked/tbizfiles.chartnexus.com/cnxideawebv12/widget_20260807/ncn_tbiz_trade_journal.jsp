		</div>
	</div>
	
	<div class="container mt-4" id="topWinnersContainer" style="display: none;">
		<div class="group-title text-center">TOP WINNERS</div>
		<div class="top-cards-wrapper mb-4" id="winners"></div>
	</div>
	
	<div class="container mt-4" id="topLosersContainer" style="display: none;">
		<div class="group-title text-center">TOP LOSERS</div>
		<div class="top-cards-wrapper" id="losers"></div>
	</div>
	
	<div class="container mt-5 position-relative">
		<div class="d-flex justify-content-between align-items-end mb-2 border-bottom pb-2">
		    <div class="fw-bold">Open Positions</div>
		    <div class="dropdown">
		        <i class="fa fa-filter" id="openFilterIcon" data-mdb-toggle="dropdown" data-mdb-auto-close="outside" aria-expanded="false" style="font-size: 16px; cursor: pointer;"></i>
		        <ul class="dropdown-menu dropdown-menu-end p-0 custom-filter-menu" id="openFilterMenu"></ul>
		    </div>
		</div>
		<div class="bg-white border rounded shadow-sm" style="overflow-x: auto;">
			<div id="openTbl"></div>
		</div>
		<div class="text-center mt-3">
			<button id="addTradeBtn" class="btn btn-dark btn-sm px-4 rounded-pill w-100" style="background-color: #0f3d56;">Add new trade <i class="fa fa-plus-circle ms-1"></i></button>
		</div>
	</div>

	<div class="container mt-5 mb-5 position-relative">
		<div class="d-flex justify-content-between align-items-end mb-2 border-bottom pb-2">
		    <div class="fw-bold">Closed Trades</div>
		    <div class="dropdown">
		        <i class="fa fa-filter" id="closedFilterIcon" data-mdb-toggle="dropdown" data-mdb-auto-close="outside" aria-expanded="false" style="font-size: 16px; cursor: pointer;"></i>
		        <ul class="dropdown-menu dropdown-menu-end p-0 custom-filter-menu" id="closedFilterMenu"></ul>
		    </div>
		</div>
		<div class="bg-white border rounded shadow-sm" style="overflow-x: auto;">
			<div id="closedTbl"></div>
		</div>
	</div>

	<div id="mainOverlay" class="custom-modal">
	  <div class="modal-stack" style="display: flex; flex-direction: column; gap: 15px; align-items: center;">
	    
	    <!-- Top Box: Starting Equity -->
	    <div id="equityBox" class="custom-modal-content">
	      <div class="custom-modal-header">
	        <span class="custom-modal-close" id="closeEquity">&times;</span>
	      </div>
	      <!-- Hidden input for editing transaction -->
	      <input type="hidden" id="editTxId" value="" />
	      
	      <div class="custom-modal-body">

          <div class="modal-row">
            <div class="modal-label">Account Currency</div>
            <div class="modal-input-container">
              <select id="currencyDropdown" class="modal-select">
                <option value="USD">US Dollar (USD)</option>
                <option value="SGD">Singapore Dollar (SGD)</option>
                <option value="MYR">Malaysian Ringgit (MYR)</option>
                <option value="IDR">Indonesian Rupiah (IDR)</option>
                <option value="HKD">Hong Kong Dollar (HKD)</option>
                <option value="CNY">Chinese Yuan (CNY)</option>
                <option value="EUR">Euro (EUR)</option>
                <!-- Add more as needed -->
              </select>
            </div>
          </div>
          <div class="modal-row">
            <div class="modal-label">Starting Equity</div>
            <div class="modal-input-container" style="display:flex;align-items:center;gap:4px;">
              <span id="txStartingEquitySymbol" style="font-weight:bold;white-space:nowrap;">$</span>
              <input type="text" id="startingEquityInput" class="modal-input bg-grey" placeholder="0" style="text-align:right;flex:1;" />
            </div>
          </div>
          <!-- <div class="modal-row" id="buyingPowerRow">
            <div class="modal-label">Buying Power</div>
            <div class="modal-input-container" style="display:flex;align-items:center;gap:4px;">
              <span id="buyingPowerSymbol" style="font-weight:bold;white-space:nowrap;">$</span>
              <span id="buyingPowerDisplay" style="font-weight:bold;font-size:13px;text-align:right;flex:1;color:#0f3d56;">0.00</span>
            </div>
          </div> -->
          <div class="modal-row">
            <div class="modal-label">Date</div>
            <div class="modal-input-container">
              <input type="text" id="startingEquityDateInput" class="modal-input" style="text-align: right;" placeholder="DD-MM-YYYY" />
               <div class="modal-required-hint" id="startingDateRequiredHint">Please set a starting date.</div>
               <div class="modal-required-hint" id="startingDateFutureHint" style="color: #ef4444; display: none;">Date cannot be in the future.</div>
             </div>
          </div>
	        
	        <hr class="modal-divider"/>
	        
	        <div class="modal-row">
	          <div class="modal-label"></div>
	          <div class="modal-input-container">
	            <select id="txType" class="modal-select">
	              <option value="Deposit">Deposit</option>
	              <option value="Withdraw">Withdraw</option>
	            </select>
	          </div>
	        </div>
	        
	        <div class="modal-row">
	          <div class="modal-label">Amount</div>
	          <div class="modal-input-container" style="display:flex;align-items:center;gap:4px;">
	            <span id="txAmountSymbol" style="font-weight:bold;white-space:nowrap;">$</span>
	            <input type="text" id="txAmount" class="modal-input bg-grey" placeholder="0" style="text-align: right;flex:1;"/>
	          </div>
	        </div>
	        
	        <div class="modal-row">
	          <div class="modal-label">Date</div>
	          <div class="modal-input-container">
	            <input type="text" id="txDate" class="modal-input bg-grey" placeholder="DD-MM-YY" style="text-align: right;" />
	            <span id="txDateHint" style="display:none;color:#c0392b;font-size:11px;margin-top:2px;"></span>
	          </div>
	        </div>
	        
          <div class="modal-actions">
            <button class="btn-submit" id="submitTransactionBtn">Submit</button>
            <span class="btn-cancel" id="cancelEquity">Cancel</span>
          </div>
	        
	        <div class="modal-footer-link">
	          <a href="#" id="showHistorical">See historical trades</a>
	        </div>
	      </div>
	    </div>
	    
	    <!-- Bottom Box: Historical Trades -->
	    <div id="historicalBox" class="custom-modal-content" style="display: none; width: 380px;">
	      <div class="custom-modal-header">
	        <span class="custom-modal-close" id="closeHistorical">&times;</span>
	      </div>
	      <div class="custom-modal-body" style="padding: 15px 20px;">
	        <table class="historical-table">
	          <thead>
	            <tr>
	              <th class="hist-th">Date</th>
	              <th class="hist-th">Transaction</th>
	              <th class="hist-th">Amount</th>
	              <th class="hist-th" style="border-right: none;"></th>
	            </tr>
	          </thead>
	          <tbody id="historicalTbody">
	            <!-- Dynamically populated -->
	          </tbody>
	        </table>
	        
	        <div class="pagination-container mt-3" id="historicalPagination">
	          <!-- Dynamically populated -->
	        </div>
	      </div>
	    </div>
	
	  </div>
	</div>

	<!-- Add / Edit Trade Modal -->
	<div id="addTradeOverlay">
	  <div class="add-trade-content">
	    <div class="add-trade-header">
	      <span class="add-trade-close" id="closeAddTrade">&times;</span>
	    </div>
	    <div class="add-trade-body">
	      <div class="add-trade-title" id="tradeModalTitle">Add New Trade</div>
	      
	      <!-- Hidden input to track if we are editing an existing trade -->
	      <input type="hidden" id="editTradeId" value="" />
	      <!-- Hidden input to track the market id (mid) of the selected ticker -->
	      <input type="hidden" id="tradeMid" value="" />
	      
	      <form id="addTradeForm">
      <div class="add-trade-grid">
	        <!-- Left Column -->
	        <div class="add-trade-row">
	          <div class="add-trade-label">Stock Ticker</div>
	          <input type="text" id="tradeTicker" class="add-trade-input bg-grey" required />
	        </div>
	        
	        <!-- Right Column (Row 1) -->
	        <div class="add-trade-row">
	          <div class="add-trade-label">Entry Price</div>
	          <input type="number" id="tradeEntryPrice" class="add-trade-input bg-grey" placeholder="Entry Price" min="0.000001" step="any" required />
	        </div>
	        
	        <!-- Left Column -->
	        <div class="add-trade-row">
	          <div class="add-trade-label">Strategy</div>
	          <input type="text" id="tradeStrategy" class="add-trade-input bg-grey" />
	        </div>
	        
	        <!-- Right Column (Row 2) -->
	        <div class="add-trade-row">
	          <div class="add-trade-label">Stop Loss Price</div>
	          <input type="number" id="tradeSlPrice" class="add-trade-input bg-grey" placeholder="Stop Loss Price" min="0" step="any" />
	        </div>
	        
	        <!-- Left Column -->
	        <div class="add-trade-row">
	          <div class="add-trade-label">Entry Type</div>
	          <select id="tradeEntryType" class="add-trade-input text-dark bg-grey">
	            <option value="Long">Long</option>
	            <option value="Short">Short</option>
	          </select>
	        </div>
	        
	        <!-- Right Column (Row 3) -->
	        <div class="add-trade-row">
	          <div class="add-trade-label">Take Profit Price</div>
	          <input type="number" id="tradeTpPrice" class="add-trade-input bg-grey" placeholder="Take Profit Price" min="0" step="any" />
	        </div>
	        
	        <!-- Left Column -->
	        <div class="add-trade-row" style="align-items: flex-start; grid-row: 4;">
	          <div class="add-trade-label" style="margin-top: 4px;">Entry Date</div>
	          <div style="flex:1;display:flex;flex-direction:column;">
	            <input type="text" id="entryDateInput" class="add-trade-input bg-grey" placeholder="DD/MM/YYYY" required />
	            <span id="entryDateHint" style="display:none;color:#c0392b;font-size:11px;margin-top:2px;"></span>
	          </div>
	        </div>
	        
	        <!-- Right Column (Row 4) -->
	        <div class="add-trade-row" style="align-items: flex-start; grid-row: 4 / span 2;">
	          <div class="add-trade-label" style="margin-top: 4px;"># of Shares</div>
	          <div style="flex: 1; display: flex; flex-direction: column; gap: 15px;">
	            <input type="number" id="tradeQty" class="add-trade-input bg-grey" placeholder="# of Shares" min="1" step="1" required />
	            
	            <!-- Remarks right below # of Shares -->
	            <div style="display: flex; gap: 10px; margin-left: -100px;">
	              <div class="add-trade-label" style="margin-top: 4px;">Remarks</div>
	              <textarea id="tradeRemarks" class="add-trade-input bg-grey" placeholder="Remarks" style="height: 80px;"></textarea>
	            </div>
	          </div>
	        </div>
	      </div>
	      
	      <div id="bpWarning" style="display:none;color:#c0392b;font-size:11px;text-align:center;margin-top:12px;"></div>
      <div class="add-trade-actions">
	        <button type="button" class="btn-submit-green" id="submitTradeBtn">Submit</button>
	        <span class="btn-cancel" id="cancelAddTrade">Cancel</span>
	      </div>
	      </form>
	    </div>
	  </div>
	</div>

	<!-- Full List Modal -->
	<div id="fullListOverlay">
	  <div class="full-list-content">
	    <div class="full-list-header">
	      <span class="full-list-close" id="closeFullList">&times;</span>
	    </div>
	    <div class="full-list-body">
	      <div class="full-list-title-row">
	        <span class="full-list-title" id="fullListModalTitle">Top Winners ($)</span>
	        <select class="full-list-filter" id="fullListFilter">
	          <option value="All">All</option>
	          <option value="Closed">Closed Trades</option>
	          <option value="Open">Open Trades</option>
	        </select>
	      </div>
	      
	      <div class="full-list-table-container">
	        <table class="full-list-table">
	          <thead>
	            <tr>
	              <th>Status</th>
	              <th>Entry Date</th>
	              <th>Stock</th>
	              <th style="text-align: right;"><span id="lbl-fulllist-pnl">PnL($)</span></th>
	              <th style="text-align: right;">PnL(%)</th>
	            </tr>
	          </thead>
	          <tbody id="fullListTbody">
	            <!-- Dynamically populated -->
	          </tbody>
	        </table>
	        
	        <div class="full-list-pagination" id="fullListPagination">
	          <!-- Dynamically populated -->
	        </div>
	      </div>
	    </div>
	  </div>
	</div>

<script src="https://theme.chartnexus.com/widgetjs/widgetjs_20260807/tbiz_trade_journal.js?v=20260807"></script>

</body>
</html>