<script>

var myWorker;
var myWorkerOnMessageReady = false

function cnx_onWindowIDReady(frame_id){
	var myfid = frame_id.replace("p-","");
	initCollapseMenu(myfid);
	registerCssBuilderListener();
	$(".content_change_menu").click(function(){
		var left = $(".content_change_menu").offset().left + $(".content_change_menu").width();
		cnx_popWidgetMenu(left,$(this).offset().top);
	});
	
	generateTabsV2()
	requestHuobiSymbolV2();
	
	if(window.Worker){
		myWorker = new Worker("worker/crypto_quotes_worker.js");
		myWorker.onmessage = function(e) {
			  const d = new Date();
			  let from_time = d.getTime();
// 			  console.log("Before process table ");
			  processTableV3(e.data);
			  const to_d = new Date();
			  let to_time = to_d.getTime();
			  var totalsec = to_time - from_time + 0.0;
// 			  console.log("Finish process table " + totalsec/1000);
			  myWorkerOnMessageReady = true
		}
	} 
	
	storeUserSelection.register()
	storeUserSelection.load()
}

var last_json = [];
var tickerTimeout;

function requestHuobiTickers(ourl){
	var url = "quotes.json"
	if(ourl!=null){
		url = ourl
	}
	var data = {
			symbols :"_all_",
			topic_path:"/lvqt/HUOBI",
	}
	$.ajax({
		url : "https://crypto.chartnexus.com/livev2/quotes",
		data : data,
		type: 'GET',
		success : function (response) 
		{
			if(response!=null && response.length>0 ){
				var json = JSON.parse(response)
				
				if(last_json.length == 0){					
					processTableV3(json);
				}else{
					if(!myWorkerOnMessageReady){
						processTableV3(json);
					}
					if(window.Worker && myWorker != null){
						myWorker.postMessage([last_json, json]);
					}
				}
				last_json = [...json];
			}
		},
		complete: function(data) {
			if(tickerTimeout != null){
				clearTimeout(tickerTimeout)
			}
			
			tickerTimeout = setTimeout(function(){
				requestHuobiTickers();
			}, 10000);
        }
	});
}

const tabs = ["usdt","husd","btc","eth","ht","usdc","ust"]

var storeUserSelection = new StoreUserSelection({
	key:"crypto_quotes_selections",
	callback:function(payload){
		var sel_tab = payload["tab"]
		if(typeof sel_tab !== "undefined"){
			var {id} = sel_tab
			var btnElement = $(".tab-check[name='btnradio'][value='"+id+"']")
			if(btnElement.length > 0){				
				btnElement[0].click()
			}
		}
	}
});

function requestHuobiSymbolV2(){
	$.ajax({
		url : "https://api.huobi.pro/v1/common/symbols",
		type: 'GET',
		success : function (response) 
		{
			
			if(response!=null&&response.status=="ok"&&response.data!=null){
				
				var arr = response.data;
				
				currentList = arr
				
				//onclick='cnx_selectCounter(46, \""+arr[i]["symbol"]+"\")'
				
				var map = {}
				for(var i = 0; i<arr.length; i++){
					var obj = arr[i]
					var id = obj["quote-currency"]
					if(typeof map[id] === "undefined"){
						map[id] = []
					}
					map[id].push(obj)
				}
				
// 				console.log(map)
				
				var data = []
				for(var key of tabs){
					var values = map[key]
					if(values != null){
						for(var value of values){
							value.id = value.symbol
						}
						data.push(...values)
					}
				}
				
				if(cryptoQuote != null){					
					cryptoQuote.replaceData(data)
					cryptoQuote.filterData()
				}
				
// 				console.log(data)
				
				requestHuobiTickers();
			}
		}
	})
}

function processTableV3(response){
// 	console.log(response)
	
	if(cryptoQuote != null){					
		cryptoQuote.processTableV3(response)
	}
}


function generateTabsV2(){
	var html = []
	for(var tab of tabs){
		var checked = html.length == 0 ? "checked" : ""
		var displaySymb = tab == "ust" ? "alts" : tab
				
		html.push(`<li><input type="radio" class="tab-check" name="btnradio" id="btnradio_${tab}" autocomplete="off" ${checked} value="${tab}">
				<label class="myTabBtn" for="btnradio_${tab}">${displaySymb}</label></li>`)
	}
	$(".tabsSymb").html(html.join(""))
}


$(document).on("click","input[type=radio][name=btnradio]",function(e) {
	cryptoQuote.filterData(false)
	cryptoQuote.scrollBackToTop()
	
	var value = $(this).val()
	storeUserSelection.save({
		key:"tab", value:{ id:value }
	})
}); 

