function setSelectedNoteByDate(noteDate){
	//var time = new Date(time);
	$(".note_content_td").removeClass('active');
	for(var x=0;x<narray.length;x++){
		if(noteDate == narray[x][7]){
			$("#note_td_"+x).addClass('active');
		}
	}
}

function reloadNotes(){
	var map = {};
	map["mode"] = "list"
	var data_token = "notes";
	cnx_dataRequest(data_token, map, function callback(data)
	{
		$("#notes_listing").html("");
		console.log(JSON.stringify(data));
		if(data!=null&&data["errcode"]==0){
			var dataobj = data["value_wcb"];
			if(dataobj!=null&&dataobj["list"]!=null){
				var notes_array = dataobj["list"];
				var notes_html = "";
				narray = notes_array;
				
			 	if(notes_array != null && notes_array.length > 0){
					for(let note of notes_array){
						if(note != null && note.length >2){
							note[2] = DOMPurify.sanitize(note[2], {
							    ALLOWED_TAGS: ALLOWED_TAGS, // Allow only safe tags
							});
						}
					}
				}
				 
				
				for(var x=0;x<notes_array.length;x++){
					var notes_info = notes_array[x];
					
					var runtime_id = notes_info[0];
					var date = notes_info[1];
					var text = notes_info[2];
					var mid = notes_info[3];
					var stockcode = notes_info[4];
