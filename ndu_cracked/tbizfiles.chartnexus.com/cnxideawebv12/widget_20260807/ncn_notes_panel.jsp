$( window ).resize(function() {
	resizePanel();
});

function resizePanel(){
// 	var tole = 45;
// 	var tole = 15;
	var tole = 0;
	var upper_height = $("#my_part_1").height();
	var window_height = window.innerHeight;
	var window_width = window.innerWidth;
	var rest_height = window_height - upper_height - tole;
	$("#my_part_3").height(rest_height+"px");
}

function checkSeeMoreRequire(){
	for(var x=0;x<narray.length;x++){
		const scrollY = $('#note'+x)[0].scrollHeight;
		const height =  $('#note'+x).innerHeight()+1;
		if (scrollY > height) {
			$('#more'+x).addClass('active')
			$('#note'+x).css('margin-block-end','0');
			$('#more'+x).css('margin-block-end','1rem');
		}
	}
}

function readMore(x){
	$('#note'+x).addClass('active')
	$('#less'+x).addClass('active')
	$('#more'+x).removeClass('active')
}

function readLess(x){
	$('#note'+x).scrollTop(0);
	$('#note'+x).removeClass('active')
	$('#less'+x).removeClass('active')
	$('#more'+x).addClass('active')
}

</script>

